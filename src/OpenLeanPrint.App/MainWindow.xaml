<Window x:Class="OpenLeanPrint.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenLeanPrint" Height="800" Width="1220" MinHeight="560" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Chrome}"
        Foreground="{StaticResource Ink}"
        Icon="pack://application:,,,/OpenLeanPrint;component/Assets/OpenLeanPrint.ico"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">

    <DockPanel>

        <!-- Toolbar: everything that changes the layout -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,10">
            <WrapPanel>
                <Button x:Name="AddButton" Content="Add PDFs…" Click="AddJobs_Click"/>
                <Button x:Name="RemoveButton" Content="Remove" Click="RemoveJob_Click"/>
                <ToggleButton x:Name="CollectToggle" Content="Collect captured jobs" Margin="6,0,0,0"
                              Click="Collect_Click"
                              ToolTip="Run the virtual printer service and add every job you print to the pool"/>
                <Button x:Name="PrinterSetupButton" Content="Set up virtual printer…" Click="PrinterSetup_Click"
                        ToolTip="Creates the Windows printer queue that feeds OpenLeanPrint. Needs administrator rights once."/>

                <Border Width="1" Background="{StaticResource Line}" Margin="8,2,14,2"/>

                <TextBlock Text="Layout" Style="{StaticResource Label}" Margin="0,3,8,3"
                           ToolTip="How many pages go on one sheet. These buttons are the usual choices and simply fill in the Grid box next to them."/>
                <ToggleButton x:Name="Preset1Up" Content="1-up" Click="Preset_Click" Tag="1x1"/>
                <ToggleButton x:Name="Preset2Up" Content="2-up" Click="Preset_Click" Tag="2x1"
                              ToolTip="Two pages per sheet: stacked and turned sideways, which fills the sheet. Side by side upright is 1x2 in the Grid box."/>
                <ToggleButton x:Name="Preset4Up" Content="4-up" Click="Preset_Click" Tag="2x2" IsChecked="True"/>
                <ToggleButton x:Name="Preset9Up" Content="9-up" Click="Preset_Click" Tag="3x3"/>
                <ToggleButton x:Name="PresetBooklet" Content="Booklet" Click="Preset_Click" Tag="booklet"/>

                <TextBlock Text="Grid" Style="{StaticResource Label}"/>
                <TextBox x:Name="GridBox" Width="62" Text="2x2" TextChanged="Grid_Changed"
                         ToolTip="Pages per sheet, as rows × columns: 2x2 puts four pages on a sheet — the same thing the 4-up button does. Type anything the buttons do not cover, such as 2x3, 1x4, or just a count like 6. The box always shows the layout in force, which is why choosing 4-up writes 2x2 here."/>

                <TextBlock Text="Paper" Style="{StaticResource Label}"/>
                <ComboBox x:Name="PaperBox" Width="92" SelectionChanged="Paper_Changed"/>

                <TextBlock Text="Margin" Style="{StaticResource Label}"
                           ToolTip="The blank border around the whole sheet. Leave 10 mm or more if the sheets are to be stapled or punched."/>
                <TextBox x:Name="MarginBox" Text="8" TextChanged="Debounced_Changed"
                         ToolTip="The blank border around the whole sheet. Leave 10 mm or more if the sheets are to be stapled or punched."/>
                <TextBlock Text="mm" Style="{StaticResource Label}" Margin="4,3,0,3"/>

                <TextBlock Text="Gutter" Style="{StaticResource Label}"
                           ToolTip="The space between the pages on a sheet. Margin is the border around the outside, gutter is the gap in the middle - with a 1x1 layout it does nothing at all."/>
                <TextBox x:Name="GutterBox" Text="2" TextChanged="Debounced_Changed"
                         ToolTip="The space between the pages on a sheet. Margin is the border around the outside, gutter is the gap in the middle - with a 1x1 layout it does nothing at all."/>
                <TextBlock Text="mm" Style="{StaticResource Label}" Margin="4,3,0,3"/>

                <CheckBox x:Name="BorderToggle" Content="Page borders" Click="Border_Changed"
                          ToolTip="Draws a thin frame around every page. Without one, four pages on a sheet with white space between them read as a single crowded page."/>

                <TextBlock Text="Watermark" Style="{StaticResource Label}"/>
                <TextBox x:Name="WatermarkBox" Width="120" TextChanged="Debounced_Changed"
                         ToolTip="Text drawn diagonally across every sheet, e.g. DRAFT. Empty means none."/>

                <Border Width="1" Background="{StaticResource Line}" Margin="14,2,10,2"/>

                <TextBlock Text="Profile" Style="{StaticResource Label}" Margin="0,0,6,0"/>
                <ComboBox x:Name="ProfileBox" Width="150" IsEditable="True"
                          SelectionChanged="Profile_Selected"
                          ToolTip="Pick a saved layout, or type a name and press Save to keep the current one."/>
                <Button x:Name="SaveProfileButton" Content="Save" Click="SaveProfile_Click" Margin="6,0,0,0"/>
                <Button x:Name="DeleteProfileButton" Content="✕" Click="DeleteProfile_Click"
                        ToolTip="Delete the selected profile"/>
            </WrapPanel>
        </Border>

        <!-- Action bar: what leaves the app -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}"
                BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,10">
            <DockPanel>
                <Button x:Name="PrintCloseButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                        Content="Print and close" Click="PrintAndClose_Click" Margin="6,3,0,3" MinWidth="120"
                        IsDefault="True"
                        ToolTip="Print, empty the pool and put the window away. The usual end of a job: what you have printed is done with."/>
                <Button x:Name="PrintButton" DockPanel.Dock="Right"
                        Content="Print" Click="Print_Click" Margin="6,3,0,3" MinWidth="90"
                        ToolTip="Print and leave everything as it is - for a second copy, or another printer."/>
                <ComboBox x:Name="PrinterBox" DockPanel.Dock="Right" Width="220"/>
                <TextBlock DockPanel.Dock="Right" Text="Printer" Style="{StaticResource Label}"/>
                <ComboBox x:Name="DuplexBox" DockPanel.Dock="Right" Width="180"
                          ToolTip="Long edge is the usual choice for upright sheets - the back reads like the next page of a book. Booklets need short edge instead: their sheets are landscape, so flipping the long edge prints every second side upside down. What was actually applied is reported after printing."/>
                <TextBlock DockPanel.Dock="Right" Text="Sides" Style="{StaticResource Label}"/>
                <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save PDF…" Click="Save_Click"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource InkMuted}" Text="No jobs yet."/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Job pool. The quieter of the two greys, so the white job cards
                 have something to stand out from. -->
            <Border Background="{StaticResource Chrome}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="14,12,14,8">
                        <StackPanel>
                            <TextBlock Text="Job pool" FontWeight="SemiBold"/>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="One entry per PDF. They are laid onto shared sheets in this order — use ↑ ↓ to change it. Select one to choose which of its pages to print; the preview jumps to it."/>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Bottom" Padding="10,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Pages" Style="{StaticResource Label}" Margin="0,0,6,0"/>
                                <TextBox x:Name="PagesBox" Width="150" TextChanged="Pages_Changed"
                                         ToolTip="Which pages of the selected job to print, e.g. 1-4,7 or 3-. Empty means all."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="UpButton" Content="↑" Click="MoveUp_Click" ToolTip="Move job up"/>
                                <Button x:Name="DownButton" Content="↓" Click="MoveDown_Click" ToolTip="Move job down"/>
                                <Button x:Name="ClearButton" Content="Clear" Click="Clear_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <ListBox x:Name="JobList" BorderThickness="0" Margin="8,0"
                                 Background="Transparent"
                                 SelectionChanged="JobList_SelectionChanged"
                                 PreviewMouseRightButtonDown="JobList_RightButtonDown"
                                 ContextMenuOpening="JobList_ContextMenuOpening"
                                 HorizontalContentAlignment="Stretch">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource JobCard}"/>
                            </ListBox.ItemContainerStyle>

                            <!-- The menu lives on the list, not in the item
                                 style. Handlers on elements inside a
                                 Setter.Value are wired by the XAML compiler
                                 through connection ids and come out crossed -
                                 it hands a MenuItem to a TextBlock handler and
                                 the window will not open at all. Which row was
                                 clicked is settled in code instead. -->
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Remove from the pool" Click="RemoveJob_Click"/>
                                    <MenuItem Header="Print all pages of this job" Click="RestoreJobPages_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Empty the pool" Click="Clear_Click"/>
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{StaticResource InkMuted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="EmptyPoolHint" Margin="18" TextWrapping="Wrap"
                                   Foreground="{StaticResource InkMuted}" VerticalAlignment="Top"
                                   Text="Drop PDFs here, or use Add PDFs — or switch on “Collect captured jobs” and print from any application. Several jobs are combined onto shared sheets, in this order."/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Preview -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="{StaticResource Mat}" Padding="28">
                    <Grid>
                        <Border x:Name="SheetShadow" Background="White" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.45" Color="Black"/>
                            </Border.Effect>
                            <Image x:Name="PreviewImage" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   MouseRightButtonUp="Preview_RightClick"/>
                        </Border>

                        <TextBlock x:Name="PreviewHint" Foreground="#FFD8D8DE" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Text="The imposed sheet appears here."/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="0,10,0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PrevSheet" Content="◀" Click="PrevSheet_Click"/>
                        <TextBlock x:Name="SheetLabel" Text="—" MinWidth="140" TextAlignment="Center"/>
                        <Button x:Name="NextSheet" Content="▶" Click="NextSheet_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="PreviewTip" HorizontalAlignment="Center" Margin="0,6,0,0"
                               FontSize="11" Foreground="{StaticResource InkMuted}"
                               Text="Right-click a page in the preview to remove it."/>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
