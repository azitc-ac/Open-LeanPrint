<Project Sdk="Microsoft.NET.Sdk">

  <!--
    OpenLeanPrint.Compose turns an ImpositionResult from the Core engine into a
    real imposed output PDF by placing source PDF pages into their computed
    cells (position, scale, rotation). Vector composition via PdfSharpCore
    (MIT, cross-platform, pure managed) - no native dependencies, testable on
    any OS. This output PDF is both the WYSIWYG content and the basis for M3
    (forwarding to a printer).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OpenLeanPrint.Compose</RootNamespace>
    <AssemblyName>OpenLeanPrint.Compose</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenLeanPrint.Core\OpenLeanPrint.Core.csproj" />
  </ItemGroup>

</Project>
