<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Command-line front-end for the imposition pipeline (impose / sample commands).
    Runs on any OS; handy for applying N-up to a captured PDF from the command line.
    See Program.cs usage text for options.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OpenLeanPrint.Cli</RootNamespace>
    <AssemblyName>openleanprint</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenLeanPrint.Core\OpenLeanPrint.Core.csproj" />
    <ProjectReference Include="..\OpenLeanPrint.Compose\OpenLeanPrint.Compose.csproj" />
  </ItemGroup>

</Project>
