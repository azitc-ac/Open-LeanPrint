<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Command-line front-end for the imposition pipeline (impose / sample / print /
    list-printers). Builds and runs on any OS - the printing commands are guarded
    with OperatingSystem.IsWindows() and refuse to run elsewhere.
    See Program.cs usage text for options.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>OpenLeanPrint.Cli</RootNamespace>
    <AssemblyName>openleanprint</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PdfSharpCore" Version="1.3.67" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenLeanPrint.Core\OpenLeanPrint.Core.csproj" />
    <ProjectReference Include="..\OpenLeanPrint.Compose\OpenLeanPrint.Compose.csproj" />
    <ProjectReference Include="..\OpenLeanPrint.Print\OpenLeanPrint.Print.csproj" />
  </ItemGroup>

</Project>
