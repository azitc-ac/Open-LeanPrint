<?xml version="1.0" encoding="utf-8"?>
<!--
  The OpenLeanPrint installer.

  It exists because the app alone cannot finish the job: creating a Windows
  printer queue needs administrator rights, and an installer already has them.
  So installing sets up the virtual printer too, and the user can print into
  OpenLeanPrint straight away instead of hunting for a setup step.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="OpenLeanPrint"
           Manufacturer="Alexander Zarenko"
           Version="$(ProductVersion)"
           UpgradeCode="6f4c6e50-7072-696e-7420-4f70656e4c50"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="Pool print jobs, impose them N-up or as a booklet, and print the result." />
    <!-- AllowSameVersionUpgrades because the product code is regenerated on
         every build: without it, reinstalling the same version leaves two
         entries in "Programs and Features" instead of replacing one. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of OpenLeanPrint is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\src\OpenLeanPrint.App\Assets\OpenLeanPrint.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/azitc-ac/Open-LeanPrint" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <!-- Minimal, deliberately: the InstallDir dialog pulls in a path-validation
         custom action that ships as an x86 DLL, and this installer has to work
         on arm64 where that is the shakiest part of the whole package. Program
         Files is the right place anyway. -->
    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="OpenLeanPrint" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="StartupFolder" />

    <Feature Id="Main" Title="OpenLeanPrint" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="SetupFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <!-- The scripts that create and remove the printer travel with the app, so
         the user can rerun them by hand if they ever need to. -->
    <ComponentGroup Id="SetupFiles" Directory="INSTALLFOLDER">
      <Component>
        <File Id="SetupPrinterScript" Source="Setup-Printer.ps1" />
      </Component>
      <Component>
        <File Id="RemovePrinterScript" Source="Remove-Printer.ps1" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts">
      <Component Directory="ProgramMenuFolder" Guid="a1f2c3d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d">
        <Shortcut Id="StartMenuShortcut"
                  Name="OpenLeanPrint"
                  Description="Pool print jobs and put several pages on one sheet"
                  Target="[INSTALLFOLDER]OpenLeanPrint.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\OpenLeanPrint" Name="StartMenu"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Starts hidden in the tray at login: the capture service has to be
           listening when you print, and nobody wants a window for that. -->
      <Component Directory="StartupFolder" Guid="b2e3d4c5-6f7a-4b8c-9d0e-1f2a3b4c5d6e">
        <Shortcut Id="StartupShortcut"
                  Name="OpenLeanPrint"
                  Description="Collect print jobs in the background"
                  Target="[INSTALLFOLDER]OpenLeanPrint.exe"
                  Arguments="--tray"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\OpenLeanPrint" Name="Startup"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!--
      The installer does NOT create the printer, and that is a measured decision
      rather than an omission.

      Measured: from a deferred custom action - SYSTEM, session 0, reported by
      the installer as having sufficient privileges, with the IPP service up and
      answering on the port - Add-Printer returns "access is denied". Three
      installations were logged to establish it. The same command from an
      elevated user session succeeds.

      Not established: why. Microsoft documents no session requirement for
      Add-Printer, and the Point and Print policies usually blamed for this are
      not set on the machine where it was reproduced. What is certain is the
      behaviour, not the mechanism.

      So the app asks for it instead, once, on first run - in a session where it
      demonstrably works.

      Uninstalling still tries to take the queue away - leaving a printer behind
      that nothing answers would swallow print jobs silently. It is best effort:
      Return="ignore" keeps a failure here from breaking the uninstall.
    -->
    <CustomAction Id="RemovePrinter"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File Remove-Printer.ps1"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RemovePrinter" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>

  </Package>
</Wix>
