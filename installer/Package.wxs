<?xml version="1.0" encoding="utf-8"?>
<!--
  The OpenLeanPrint installer.

  It exists because the app alone cannot finish the job: creating a Windows
  printer queue needs administrator rights, and an installer already has them.
  So installing sets up the virtual printer too, and the user can print into
  OpenLeanPrint straight away instead of hunting for a setup step.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    Both identifiers are fixed. WiX would otherwise generate a fresh ProductCode
    on every build, which makes each build a different product to Windows: the
    uninstall GUID changes constantly, "msiexec /x" with a written-down GUID
    stops working, and reinstalling can leave two entries behind.
  -->
  <Package Name="OpenLeanPrint"
           Manufacturer="Alexander Zarenko"
           Version="$(ProductVersion)"
           ProductCode="6f4c6e50-7072-696e-7421-4f70656e4c50"
           UpgradeCode="6f4c6e50-7072-696e-7420-4f70656e4c50"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="Pool print jobs, impose them N-up or as a booklet, and print the result." />
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of OpenLeanPrint is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\src\OpenLeanPrint.App\Assets\OpenLeanPrint.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/azitc-ac/Open-LeanPrint" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <!-- See the StopApp comment below: our own processes are stopped first, so
         there is nothing for the Restart Manager to find and its scan is pure
         delay. It was where an uninstall spent about two minutes. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <!-- Minimal, deliberately: the InstallDir dialog pulls in a path-validation
         custom action that ships as an x86 DLL, and this installer has to work
         on arm64 where that is the shakiest part of the whole package. Program
         Files is the right place anyway. -->
    <ui:WixUI Id="WixUI_Minimal" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="OpenLeanPrint" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="StartupFolder" />

    <Feature Id="Main" Title="OpenLeanPrint" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="SetupFiles" />
      <ComponentGroupRef Id="Shortcuts" />
    </Feature>

    <!-- The scripts that create and remove the printer travel with the app, so
         the user can rerun them by hand if they ever need to. -->
    <ComponentGroup Id="SetupFiles" Directory="INSTALLFOLDER">
      <Component>
        <File Id="SetupPrinterScript" Source="Setup-Printer.ps1" />
      </Component>
      <Component>
        <File Id="InstallServiceScript" Source="Install-Service.ps1" />
        <RemoveFile Id="RemoveServiceSetupLog" Name="service-setup.log" On="uninstall" />
      </Component>
      <Component>
        <File Id="UninstallServiceScript" Source="Uninstall-Service.ps1" />
      </Component>
      <Component>
        <File Id="StopAppScript" Source="Stop-App.ps1" />
        <RemoveFile Id="RemoveUninstallLog" Name="uninstall.log" On="uninstall" />
      </Component>
      <Component>
        <File Id="RemoveDataScript" Source="Remove-Data.ps1" />
      </Component>
      <Component>
        <File Id="RemovePrinterScript" Source="Remove-Printer.ps1" />
        <!-- Setup writes this next to itself, so the installer never learns of
             it and would leave it behind on uninstall. -->
        <RemoveFile Id="RemovePrinterSetupLog" Name="printer-setup.log" On="uninstall" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="Shortcuts">
      <Component Directory="ProgramMenuFolder" Guid="a1f2c3d4-5e6f-4a7b-8c9d-0e1f2a3b4c5d">
        <Shortcut Id="StartMenuShortcut"
                  Name="OpenLeanPrint"
                  Description="Pool print jobs and put several pages on one sheet"
                  Target="[INSTALLFOLDER]OpenLeanPrint.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\OpenLeanPrint" Name="StartMenu"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <!-- Starts hidden in the tray at login: the capture service has to be
           listening when you print, and nobody wants a window for that. -->
      <Component Directory="StartupFolder" Guid="b2e3d4c5-6f7a-4b8c-9d0e-1f2a3b4c5d6e">
        <Shortcut Id="StartupShortcut"
                  Name="OpenLeanPrint"
                  Description="Collect print jobs in the background"
                  Target="[INSTALLFOLDER]OpenLeanPrint.exe"
                  Arguments="--tray"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\OpenLeanPrint" Name="Startup"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!--
      Impersonate="yes" is the whole trick, and it was settled by experiment
      rather than by reasoning. A throwaway diagnostic package ran the same
      Add-Printer call from four custom-action configurations:

        deferred, Impersonate="no"        as SYSTEM              access is denied
        deferred, Impersonate="yes"       as the installing user creates the printer
        commit,   Impersonate="no"        as SYSTEM              access is denied
        immediate after InstallFinalize   as the installing user creates the printer

      All four ran in session 1, so the session was never the variable, and the
      commit action shows it is not about the transaction still being open
      either.

      Nor is it the account, which was the next wrong guess: a fifth measurement
      installed this package silently as SYSTEM, the way a management system
      does, and the printer was created. Add-Printer also succeeds from a
      scheduled task running as SYSTEM.

      What actually distinguishes the failing case is the context the action
      runs in: non-impersonated custom actions execute inside the Windows
      Installer service process, and Add-Printer is refused there whoever the
      account is. Impersonated ones do not, and succeed - as the installing
      user, or as SYSTEM during an unattended installation.

      That makes this deployable unattended, which was the point of testing it.
      An .msix still cannot do any of this and relies on the app's own setup.

      Both actions are best effort (Return="ignore"): a machine where this fails
      still ends up with a working app. Uninstalling takes the queue away again,
      because a printer with nothing behind it swallows print jobs silently.
    -->
    <CustomAction Id="SetupPrinter"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File Setup-Printer.ps1"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <CustomAction Id="RemovePrinter"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File Remove-Printer.ps1"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <!--
      The capture service is what makes the printer real. Without it the queue
      only works while the desktop app happens to be running - so printing broke
      right after installing, and again whenever anyone quit the app from the
      tray, leaving jobs stuck in the queue with no explanation.

      Registered before the printer is created, because Add-Printer needs
      something answering on the port, and the service is now that something.
    -->
    <CustomAction Id="InstallService"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File Install-Service.ps1"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <!--
      Uninstalling while the app was running cost two minutes, a dialog asking
      the user to close unrelated applications, and a tray icon that stayed on
      screen afterwards. All three come from the same place: Windows found the
      program in use and set the Restart Manager on it.

      So the app is asked to stop first - through its own exit path, which is
      what takes the tray icon away; a terminated process never gets to. With
      nothing of ours left running there is nothing for the Restart Manager to
      find, which is also why MSIRESTARTMANAGERCONTROL is off: its scan is what
      the two minutes were spent on.
    -->
    <CustomAction Id="StopApp"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File Stop-App.ps1"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <!--
      Captured jobs are the user's documents and are left alone; the log and the
      folders go if nothing of theirs is in them.
    -->
    <CustomAction Id="RemoveData"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File Remove-Data.ps1"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <CustomAction Id="UninstallService"
                  Directory="INSTALLFOLDER"
                  ExeCommand="powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File Uninstall-Service.ps1"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <!--
      Starting the app as well is a convenience, not a requirement: with the
      service running the printer already works. asyncNoWait so the installer
      does not wait for the app to be closed again.

      It goes through Explorer, and that is the whole point. A custom action
      inherits the installer's token, so starting the program directly started it
      as whoever authorised the installation - on a machine where that is a
      separate administrator account, the app then ran as that account, with its
      profile, its documents in the file dialog, and administrator rights it has
      no use for. An elevated window with a file browser in it is a way to run
      anything as administrator, which is not something a print utility should
      hand out.

      Asking Explorer to open the shortcut hands the launch to the session that
      already has one, so the app runs as the person sitting there. If nothing
      answers - a silent deployment, nobody logged in - then nothing starts,
      which is the right way round for this to fail: never running is a nuisance,
      running as an administrator is a hole.

      The shortcut rather than the executable, because Explorer passes no
      arguments of its own, and the switch that starts it hidden has to come
      from somewhere.

      Where it is sequenced was measured too, after a first attempt moved it to
      the UI sequence and quietly made things worse:

        installed with /qn    execute sequence ran, UI sequence did not
        installed with /qb    execute sequence ran, UI sequence did not

      Basic and silent installations do not process the UI sequence at all, and
      /qb is what the build script recommends. So the execute sequence is the
      one that has to carry it. The UI-sequence entry stays as well, for a
      full-UI installation; a double start costs nothing, because the app allows
      one copy per session and a second one just raises the first.
    -->
    <CustomAction Id="LaunchApp"
                  Directory="INSTALLFOLDER"
                  ExeCommand="explorer.exe &quot;[StartupFolder]OpenLeanPrint.lnk&quot;"
                  Execute="immediate" Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="InstallService" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="SetupPrinter" After="InstallService" Condition="NOT Installed" />
      <!-- No condition: an upgrade replaces the same files, and with the
           Restart Manager off nothing else would ask the running copy to let
           go of them. -->
      <Custom Action="StopApp" After="InstallInitialize" />
      <Custom Action="UninstallService" Before="RemovePrinter" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RemovePrinter" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="RemoveData" After="RemovePrinter" Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT Installed" />
    </InstallExecuteSequence>

    <InstallUISequence>
      <Custom Action="LaunchApp" After="ExecuteAction" Condition="NOT Installed" />
    </InstallUISequence>

  </Package>
</Wix>
