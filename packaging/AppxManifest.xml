<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the MSIX package manifest. Build-Msix.ps1 copies this into the
  package layout and patches Version, Publisher and ProcessorArchitecture -
  Publisher must match the signing certificate's subject exactly, or Windows
  refuses the package.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="AlexanderZarenko.OpenLeanPrint"
            Publisher="CN=Alexander Zarenko"
            Version="1.0.0.0"
            ProcessorArchitecture="arm64" />

  <Properties>
    <DisplayName>OpenLeanPrint</DisplayName>
    <PublisherDisplayName>Alexander Zarenko</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Pool print jobs, impose them N-up or as a booklet, and send the result to a printer.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="OpenLeanPrint" Executable="OpenLeanPrint.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="OpenLeanPrint"
        Description="Pool print jobs, impose them N-up or as a booklet, and send the result to a printer."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A packaged desktop (WPF) app: full trust, no sandboxed capabilities. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
