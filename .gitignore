# .NET build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user

# Test / coverage artifacts
[Tt]est[Rr]esults/
*.trx
*.coverage
coverage/

# Captured print jobs (real documents — never commit)
captured/

# Published builds (scripts/Publish-App.ps1) — hundreds of MB
dist/

# MSIX package layout (scripts/Build-Msix.ps1)
build/

# Signing certificates — a private key must never be committed
certs/
*.pfx

# IDE
.vs/
.idea/
*.suo

# OS cruft
.DS_Store
Thumbs.db
